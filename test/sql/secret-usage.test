# name: test/sql/secret-usage.test
# description: Real-world secret usage patterns (for README documentation, 2026-10-28)
# group: [sql]
# 编排依赖：nats_userpass 服务（admin/s3cret-pass）

require nats_rw

# ===== 方式一：显式引用（secret := 'name'）=====

statement ok
CREATE SECRET prod_auth (
    TYPE nats_rw,
    URL 'nats://nats_userpass:4222',
    USER 'admin',
    PASSWORD 's3cret-pass',
    SCOPE 'nats://nats_userpass'
);

# scan：显式 secret 名 + 显式 url（最明确，但 url 重复了 secret 里的）
statement ok
COPY (SELECT 'explicit-ref' AS v) TO 'demo_explicit' (FORMAT nats_rw,
    url 'nats://nats_userpass:4222', secret 'prod_auth', payload_column 'v', create_stream 'true');

query I
SELECT count(*) >= 1 FROM nats_rw_scan('demo_explicit', url := 'nats://nats_userpass:4222', secret := 'prod_auth') WHERE decode(payload) = 'explicit-ref';
----
true

# ===== 方式二：scope 自动匹配（不传 secret 名）=====

# scan：只传 url，scope 匹配自动找到 prod_auth（scope 'nats://nats_userpass' 是 url 前缀）
query I
SELECT count(*) >= 1 FROM nats_rw_scan('demo_explicit', url := 'nats://nats_userpass:4222') WHERE decode(payload) = 'explicit-ref';
----
true

# ===== 方式三：secret 带 URL，省略 url 参数 =====

# scan：完全不传 url 和 secret——用 secret 里存的 URL + 认证
query I
SELECT count(*) >= 1 FROM nats_rw_scan('demo_explicit', secret := 'prod_auth') WHERE decode(payload) = 'explicit-ref';
----
true

# ===== 方式四：COPY 使用 secret =====

# COPY：显式 secret 引用
statement ok
COPY (SELECT 'copy-with-secret' AS v) TO 'demo_copy' (FORMAT nats_rw,
    secret 'prod_auth', payload_column 'v', create_stream 'true');

query I
SELECT count(*) >= 1 FROM nats_rw_scan('demo_copy', secret := 'prod_auth') WHERE decode(payload) = 'copy-with-secret';
----
1

# COPY：scope 自动匹配（不传 secret）
statement ok
COPY (SELECT 'copy-scope' AS v) TO 'demo_copy2' (FORMAT nats_rw,
    url 'nats://nats_userpass:4222', payload_column 'v', create_stream 'true');

query I
SELECT count(*) >= 1 FROM nats_rw_scan('demo_copy2', url := 'nats://nats_userpass:4222') WHERE decode(payload) = 'copy-scope';
----
1

# ===== 方式五：查看已创建的 secrets =====

query I
SELECT count(*) FROM duckdb_secrets() WHERE type = 'nats_rw';
----
1

# 脱敏验证（密码/token/nkey/creds 不得出现在输出中）
query I
SELECT count(*) FROM duckdb_secrets() WHERE type = 'nats_rw'
  AND secret_string LIKE '%s3cret-pass%';
----
0

# ===== 方式六：认证服务器上的元数据函数 =====

query I
SELECT count(*) >= 1 FROM nats_rw_streams('', secret := 'prod_auth') WHERE name = 'demo_explicit';
----
1

query I
SELECT messages >= 1 FROM nats_rw_stream_info('demo_explicit', secret := 'prod_auth');
----
1

# ===== 方式七：覆盖优先级——显式 url 参数 > secret.url =====

# 创建一个 URL 错误的 secret，但用显式 url 覆盖它
statement ok
CREATE SECRET wrong_url (
    TYPE nats_rw,
    URL 'nats://wrong-host:9999',
    USER 'admin',
    PASSWORD 's3cret-pass',
    SCOPE 'nats://wrong-host'
);

# 显式 url 覆盖 secret.url → 连接到正确的服务器
query I
SELECT count(*) >= 1 FROM nats_rw_scan('demo_explicit', url := 'nats://nats_userpass:4222', secret := 'wrong_url') WHERE decode(payload) = 'explicit-ref';
----
true

# ===== 错误场景 =====

# 错误密码 → 认证拒绝
statement ok
CREATE SECRET bad_pass (TYPE nats_rw, USER 'admin', PASSWORD 'totally-wrong');

statement error
SELECT count(*) FROM nats_rw_scan('demo_explicit', url := 'nats://nats_userpass:4222', secret := 'bad_pass');
----

# 引用不存在的 secret → Binder 错误
statement error
SELECT count(*) FROM nats_rw_scan('demo_explicit', secret := 'nonexistent');
----
nonexistent
