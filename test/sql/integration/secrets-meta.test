# name: test/sql/secrets-meta.test
# description: TP-04 auth secrets + metadata functions (phase 4) - user/pass + token e2e; nkey/creds implemented but not e2e (deferred)
# group: [sql]
# plan: plans/nats-rw-duckdb-extension-test-plan.md — TP-04 组
# 编排依赖：docker compose 的 nats_userpass（admin/s3cret-pass）与 nats_token（tok-12345）服务

require nats_rw

# ---- TP-04a：用户名/密码认证 ----

# 无 secret → 服务端拒绝（认证要求）
statement error
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats_userpass:4222');
----

# 正确 secret（TP-04d 顺带：显式 url 参数 + secret 认证组合）
statement ok
CREATE SECRET up_secret (TYPE nats_rw, URL 'nats://nats_userpass:4222', USER 'admin', PASSWORD 's3cret-pass', SCOPE 'nats://nats_userpass');

statement ok
COPY (SELECT 'auth-hello' AS v) TO 'auth_rt' (FORMAT nats_rw, url 'nats://nats_userpass:4222', secret 'up_secret', payload_column 'v', create_stream 'true');

query I
SELECT count(*) FROM nats_rw_scan('auth_rt', url := 'nats://nats_userpass:4222', secret := 'up_secret')
WHERE decode(payload) = 'auth-hello';
----
1

# 错误密码 → 认证失败（非挂起）
statement ok
CREATE SECRET up_bad (TYPE nats_rw, URL 'nats://nats_userpass:4222', USER 'admin', PASSWORD 'wrong-pass', SCOPE 'nats://bad');

statement error
SELECT count(*) FROM nats_rw_scan('auth_rt', url := 'nats://nats_userpass:4222', secret := 'up_bad');
----

# secret.url 生效（不传 url 参数时用 secret 里的 URL）
query I
SELECT count(*) FROM nats_rw_scan('auth_rt', secret := 'up_secret');
----
1

# scope 自动匹配（不传 secret 名）：nats://nats_userpass 前缀命中 up_secret 的 scope
query I
SELECT count(*) FROM nats_rw_scan('auth_rt', url := 'nats://nats_userpass:4222');
----
1

# ---- TP-04b：token 认证（nkey/creds 已实现但无 e2e 服务器，登记设计债）----

statement ok
CREATE SECRET tok_secret (TYPE nats_rw, URL 'nats://nats_token:4222', TOKEN 'tok-12345');

statement ok
COPY (SELECT 42 AS v) TO 'tok_rt' (FORMAT nats_rw, url 'nats://nats_token:4222', secret 'tok_secret', create_stream 'true');

query I
SELECT count(*) FROM nats_rw_scan('tok_rt', url := 'nats://nats_token:4222', secret := 'tok_secret');
----
1

# 错 token → 拒绝
statement ok
CREATE SECRET tok_bad (TYPE nats_rw, URL 'nats://nats_token:4222', TOKEN 'wrong-token');

statement error
SELECT count(*) FROM nats_rw_scan('tok_rt', url := 'nats://nats_token:4222', secret := 'tok_bad');
----

# ---- TP-04c：脱敏（duckdb_secrets 不泄漏明文凭证）----

query I
SELECT count(*) FROM duckdb_secrets() WHERE name IN ('up_secret', 'up_bad', 'tok_secret', 'tok_bad');
----
4

# secret 显示串不得包含任何明文凭证
query I
SELECT count(*) FROM duckdb_secrets() WHERE name IN ('up_secret', 'up_bad', 'tok_secret', 'tok_bad')
  AND (secret_string LIKE '%s3cret-pass%' OR secret_string LIKE '%wrong-pass%' OR secret_string LIKE '%tok-12345%' OR secret_string LIKE '%wrong-token%');
----
0

# ---- secret 校验错误路径 ----

# USER 无 PASSWORD → 拒绝
statement error
CREATE SECRET split_secret (TYPE nats_rw, USER 'admin');
----

# 多种认证方法并存 → 拒绝
statement error
CREATE SECRET multi_secret (TYPE nats_rw, USER 'admin', PASSWORD 'p', TOKEN 't');
----

# 按名引用不存在的 secret → Binder 错误
statement error
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222', secret := 'nope_secret');
----
nope_secret

# ---- TP-04e：nats_rw_streams ----

query I
SELECT count(*) FROM nats_rw_streams('', url := 'nats://nats:4222') WHERE name = 'seed_stream' AND messages >= 10 AND last_seq >= 10;
----
1

# 认证服务器的流也要能列出（经 secret）
query I
SELECT count(*) FROM nats_rw_streams('', secret := 'up_secret') WHERE name = 'auth_rt' AND messages = 1;
----
1

# ---- TP-04f：nats_rw_stream_info ----

query III
SELECT messages, first_seq, last_seq FROM nats_rw_stream_info('seed_stream', url := 'nats://nats:4222');
----
10	1	10

query T
SELECT subjects[1] FROM nats_rw_stream_info('seed_stream', url := 'nats://nats:4222');
----
seed.>

query I
SELECT consumer_count FROM nats_rw_stream_info('seed_stream', url := 'nats://nats:4222');
----
0

# 不存在的流 → 可读错误
statement error
SELECT * FROM nats_rw_stream_info('no_such_meta_stream', url := 'nats://nats:4222');
----
no_such_meta_stream
