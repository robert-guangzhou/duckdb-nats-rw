# name: test/sql/pushdown.test
# description: Predicate pushdown for nats_rw_scan (phase 2 perf, PD-01..06)
# group: [sql]
# plan: plans/nats-rw-perf-optimization-test-plan.md
# EXPLAIN 验证需手动执行（sqllogictest 不支持 EXPLAIN 子查询）；
# 此处以功能等价断言覆盖：WHERE 条件的结果 = 手动传参的结果。

require nats_rw

# PD-02：功能等价——WHERE seq BETWEEN 3 AND 5 结果 = 手动参数 start_seq=3, end_seq=5
query III
SELECT count(*), min(seq), max(seq) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222') WHERE seq BETWEEN 3 AND 5;
----
3	3	5

query III
SELECT count(*), min(seq), max(seq) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222', start_seq := 3, end_seq := 5);
----
3	3	5

# PD-03：开区间边界——seq > 3 AND seq < 8 → 等效 [4, 7]
query III
SELECT count(*), min(seq), max(seq) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222') WHERE seq > 3 AND seq < 8;
----
4	4	7

# PD-04：等值退化——seq = 5 → 单行
query II
SELECT count(*), max(seq) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222') WHERE seq = 5;
----
1	5

# PD-04b：seq >= 4 AND seq <= 7 → 等效 [4, 7]（闭区间）
query III
SELECT count(*), min(seq), max(seq) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222') WHERE seq >= 4 AND seq <= 7;
----
4	4	7

# PD-05：时间条件下推功能等价——ts_nats >= 2026 → 全部 10 条（种子在 2026 年）
query I
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222') WHERE ts_nats >= TIMESTAMPTZ '2026-01-01 00:00:00+00';
----
10

# PD-05b：ts_nats < 2026 → 0 条（时间下推排除了全部）
query I
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222') WHERE ts_nats < TIMESTAMPTZ '2026-01-01 00:00:00+00';
----
0

# PD-06：非下推列（subject）留在 DuckDB 层，结果正确
query I
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222') WHERE subject = 'seed.a.1';
----
1

# PD-07：下推 + 手动参数组合（取交集）
query II
SELECT count(*), max(seq) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222', start_seq := 1, end_seq := 10) WHERE seq <= 5;
----
5	5

# PD-08：多列混合——seq 下推 + subject 过滤（subject 留在 DuckDB 层）
query I
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222') WHERE seq <= 5 AND subject LIKE 'seed.a%';
----
5
