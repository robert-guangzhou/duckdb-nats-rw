# name: test/sql/scan.test
# description: nats_rw_scan bounded snapshot (TP-02a/b/c/d/g, TP-02h-lite, TP-05a/b)
# group: [sql]
# plan: plans/nats-rw-duckdb-extension-test-plan.md — TP-02 组 + TP-05a/b
# fixtures: test/sql/fixtures/seed.sh（重建 seed_stream，10 条消息 seq 1..10：seed.a.1..5 unit=alpha / seed.b.1..5 unit=beta）

require nats_rw

# TP-05a：不存在的流报可读错误（含流名）
statement error
SELECT count(*) FROM nats_rw_scan('no_such_stream', url := 'nats://nats:4222');
----
no_such_stream

# TP-05b-1：错误端口（服务未监听）→ 快速拒绝为可读错误，而非挂起
statement error
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4223');
----

# TP-05b-2：不可达地址 → 5s 连接超时上限内返回错误（连接超时常量见 rust/src/scan.rs）
statement error
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://10.255.255.1:4222');
----

# TP-02a：全量快照 = 种子 10 条，seq 1..10
query III
SELECT count(*), min(seq), max(seq) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222');
----
10	1	10

# TP-02g：有界快照稳定性——两次扫描计数一致
query I
SELECT ((SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222'))
      = (SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222')))::INTEGER;
----
1

# TP-02b：subject 通配符过滤（MVP 为客户端过滤，语义同 NATS）
query T
SELECT CAST(payload AS VARCHAR) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222', subject := 'seed.a.>') ORDER BY seq;
----
payload-a-1
payload-a-2
payload-a-3
payload-a-4
payload-a-5

# TP-02c：seq 闭区间 [3,5]
query II
SELECT min(seq), max(seq) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222', start_seq := 3, end_seq := 5);
----
3	5

query I
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222', start_seq := 3, end_seq := 5);
----
3

# TP-02d：时间范围与全量交叉验证（1970..2262 全覆盖）
query I
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222',
    start_time := TIMESTAMPTZ '1970-01-01 00:00:00+00', end_time := TIMESTAMPTZ '2262-01-01 00:00:00+00');
----
10

# 时间列均非空
query I
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222') WHERE ts_nats IS NOT NULL;
----
10

# TP-02h-lite：header 取每键首个值（多值完整支持在后续阶段）
query T
SELECT DISTINCT headers['unit'] FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222') WHERE subject LIKE 'seed.a%' ORDER BY 1;
----
[alpha]

# 设计债#4（detailed-design 九）：end_seq 超过 last_seq 静默截断到快照边界
query I
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222', start_seq := 1, end_seq := 999999);
----
10

# ===== 覆盖面审查补测（CG 组，2026-10-27，先落盘未运行） =====

# CG-P1-4a：时间过滤排除性——end_time 早于消息时间 → 0 行（真过滤而非恒真）
query I
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222',
    end_time := TIMESTAMPTZ '2000-01-01 00:00:00+00');
----
0

# CG-P1-4b：start_time 晚于消息时间 → 0 行
query I
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222',
    start_time := TIMESTAMPTZ '2999-01-01 00:00:00+00');
----
0

# CG-P1-5a：batch_size=1（极小并发）结果不变
query III
SELECT count(*), min(seq), max(seq) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222', batch_size := 1);
----
10	1	10

# CG-P1-5b：batch_size=256（上限）结果不变
query I
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222', batch_size := 256);
----
10

# CG-P2-6a：输出 schema 钉死（列名/类型漂移即失败）
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222')) ORDER BY column_name;
----
headers	MAP(VARCHAR, VARCHAR[])
payload	BLOB
seq	UBIGINT
stream	VARCHAR
subject	VARCHAR
ts_nats	TIMESTAMP WITH TIME ZONE

# CG-P2-6b：stream 列取值正确
query T
SELECT DISTINCT stream FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222');
----
seed_stream

# CG-P2-6c：ts_nats 值下界（种子发布于 2026 年，非仅"非空"）
query I
SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222') WHERE ts_nats < TIMESTAMPTZ '2026-01-01 00:00:00+00';
----
0

# CG-HA-4：显式回退路径——无 allow_direct 的流走 get_raw_message（此前仅隐式覆盖）
query III
SELECT count(*), min(seq), max(seq) FROM nats_rw_scan('seed_nodirect', url := 'nats://nats:4222');
----
5	1	5

# CG-HA-2：已删除序列的跳过路径——seed_gapped 发布 12 条后删除 seq=3、7
query III
SELECT count(*), min(seq), max(seq) FROM nats_rw_scan('seed_gapped', url := 'nats://nats:4222');
----
10	1	12

query II
SELECT min(seq), max(seq) FROM nats_rw_scan('seed_gapped', url := 'nats://nats:4222') WHERE seq IN (3, 7);
----
NULL	NULL

# 并发冒烟：同查询内两路扫描（共享 runtime 双 block_on）
query I
SELECT (SELECT count(*) FROM nats_rw_scan('seed_stream', url := 'nats://nats:4222'))
     + (SELECT count(*) FROM nats_rw_scan('seed_gapped', url := 'nats://nats:4222'));
----
20
