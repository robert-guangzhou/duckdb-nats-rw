# name: test/sql/copy.test
# description: COPY TO (FORMAT nats_rw) write path (TP-03a/b/c/d/e/f + error paths)
# group: [sql]
# plan: plans/nats-rw-duckdb-extension-test-plan.md — TP-03 组
# fixtures: rt_* 流由 rust seeder 在播种阶段清理（幂等，见 rust/src/bin/seed.rs）

require nats_rw

# TP-03e + TP-03a：create_stream 建流 + 单行写入，默认整行 JSON（紧凑格式）
statement ok
COPY (SELECT 'hello' AS v) TO 'rt_stream' (FORMAT nats_rw, url 'nats://nats:4222', create_stream 'true');

query I
SELECT count(*) FROM nats_rw_scan('rt_stream', url := 'nats://nats:4222');
----
1

# 整行 JSON 序列化格式（键序 = 源列序，紧凑无空格；payload 为 BLOB，
# VARCHAR 化显示时引号转义为 \x22——2026-10-26 实测 DuckDB blob 显示约定）
query T
SELECT CAST(payload AS VARCHAR) FROM nats_rw_scan('rt_stream', url := 'nats://nats:4222');
----
{\x22v\x22:\x22hello\x22}

# TP-03b：批量 1000 行追加（流已存在，不传 create_stream），逐 seq 对账无丢失
statement ok
COPY (SELECT i FROM range(1000) t(i)) TO 'rt_stream' (FORMAT nats_rw, url 'nats://nats:4222');

query III
SELECT count(*), min(seq), max(seq) FROM nats_rw_scan('rt_stream', url := 'nats://nats:4222');
----
1001	1	1001

# TP-03c：subject_prefix 映射（读回 subject 精确匹配）
statement ok
COPY (SELECT 42 AS n) TO 'rt_sub' (FORMAT nats_rw, url 'nats://nats:4222', subject_prefix 'rt.custom', create_stream 'true');

query I
SELECT count(*) FROM nats_rw_scan('rt_sub', url := 'nats://nats:4222', subject := 'rt.custom');
----
1

# TP-03d + TP-03f：payload_column 模式，中文/空串 round-trip 逐值精确
statement ok
COPY (SELECT * FROM (VALUES ('中文测试'), (''), ('a')) t(v)) TO 'rt_pc' (FORMAT nats_rw, url 'nats://nats:4222', payload_column 'v', create_stream 'true');

query I
SELECT count(*) FROM nats_rw_scan('rt_pc', url := 'nats://nats:4222') WHERE payload = unhex('E4B8ADE69687E6B58BE8AF95');
----
1

query I
SELECT count(*) FROM nats_rw_scan('rt_pc', url := 'nats://nats:4222') WHERE payload = ''::BLOB;
----
1

query I
SELECT count(*) FROM nats_rw_scan('rt_pc', url := 'nats://nats:4222') WHERE payload = 'a'::BLOB;
----
1

# TP-03f：BLOB 字节级 round-trip（含 NUL 与高字节）
statement ok
COPY (SELECT '\x00\xFF\x7F'::BLOB AS b) TO 'rt_rt' (FORMAT nats_rw, url 'nats://nats:4222', payload_column 'b', create_stream 'true');

query I
SELECT count(*) FROM nats_rw_scan('rt_rt', url := 'nats://nats:4222') WHERE payload = '\x00\xFF\x7F'::BLOB;
----
1

# 错误路径：流不存在且未开 create_stream → 可读错误（含流名）
statement error
COPY (SELECT 1) TO 'no_rt_stream' (FORMAT nats_rw, url 'nats://nats:4222');
----
no_rt_stream

# 错误路径：服务器不可达（连接超时上限内返回，语义同 TP-05b）
statement error
COPY (SELECT 1) TO 'rt_x' (FORMAT nats_rw, url 'nats://127.0.0.1:1', create_stream 'true');
----
connect

# 审查 F2 回归：create_stream 对已存在流不得改写其 subject 过滤器
statement ok
COPY (SELECT 1 AS v) TO 'rt_guard' (FORMAT nats_rw, url 'nats://nats:4222', subject_prefix 'guard.a', create_stream 'true');

# 同流不同 subject：过滤器未被改写 → 发布不被捕获 → 报错（含 subject 名）
statement error
COPY (SELECT 2 AS v) TO 'rt_guard' (FORMAT nats_rw, url 'nats://nats:4222', subject_prefix 'guard.b', create_stream 'true');
----
guard.b

# 原过滤器仍然有效（正向证明未被改写）
statement ok
COPY (SELECT 3 AS v) TO 'rt_guard' (FORMAT nats_rw, url 'nats://nats:4222', subject_prefix 'guard.a');

query I
SELECT count(*) FROM nats_rw_scan('rt_guard', url := 'nats://nats:4222');
----
2

# ===== 覆盖面审查补测（CG 组，2026-10-27，先落盘未运行） =====

# CG-P0-1：多 chunk 写入（5000 行 > STANDARD_VECTOR_SIZE 2048，sink 至少 3 次调用）；
# 此前 rt_stream 已有 1001 条（1 + 1000），追加后精确对账 6001
statement ok
COPY (SELECT i FROM range(5000) t(i)) TO 'rt_stream' (FORMAT nats_rw, url 'nats://nats:4222');

query III
SELECT count(*), min(seq), max(seq) FROM nats_rw_scan('rt_stream', url := 'nats://nats:4222');
----
6001	1	6001

# CG-P0-2：整行 JSON 多类型序列化——时间戳（F3 防回归：值不得带 SQL 引号）、
# 整数、布尔、NULL 字段；decode(payload) 取回 VARCHAR 后精确比对
statement ok
COPY (SELECT TIMESTAMP '2026-01-02 03:04:05' AS ts, 42 AS n, true AS b, NULL AS x)
TO 'rt_json' (FORMAT nats_rw, url 'nats://nats:4222', create_stream 'true');

query T
SELECT decode(payload) FROM nats_rw_scan('rt_json', url := 'nats://nats:4222');
----
{"ts":"2026-01-02 03:04:05","n":42,"b":true,"x":null}

# CG-P1-3a：payload_column 为 NULL → 空载荷（非报错、非 "null" 字符串）
statement ok
COPY (SELECT NULL::VARCHAR AS v) TO 'rt_null' (FORMAT nats_rw, url 'nats://nats:4222', payload_column 'v', create_stream 'true');

query I
SELECT count(*) FROM nats_rw_scan('rt_null', url := 'nats://nats:4222') WHERE octet_length(payload) = 0;
----
1

# CG-P2-8a：0 行 COPY（F11 行为锚定：成功且不产生消息）
statement ok
COPY (SELECT 1 AS v WHERE false) TO 'rt_null' (FORMAT nats_rw, url 'nats://nats:4222');

query I
SELECT count(*) FROM nats_rw_scan('rt_null', url := 'nats://nats:4222');
----
1

# CG-P2-8b：非法流名（空格）→ 服务端拒绝（错误文本首轮运行校准后收紧；
# 当前用空模式=任意错误）
statement error
COPY (SELECT 1 AS v) TO 'bad stream!' (FORMAT nats_rw, url 'nats://nats:4222', create_stream 'true');
----
stream name cannot contain

# CG-P2-7：超服务端 max_payload（默认 1MB）→ 可读报错（错误文本首轮校准）
statement error
COPY (SELECT repeat('a', 1100000) AS v) TO 'rt_big' (FORMAT nats_rw, url 'nats://nats:4222', payload_column 'v', create_stream 'true');
----
max payload size exceeded
